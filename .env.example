# =============================================================================
# FIDELITY LIFE ASSURANCE - NEXA AI FRAUD DETECTION SYSTEM
# Production Environment Configuration Template
# =============================================================================

# Application Metadata
APP_NAME="NEXA – Enterprise Insurance Fraud Intelligence Platform"
APP_VERSION="2.0.0"
# "development" or "production". In production the app refuses a known JWT
# secret, wildcard CORS, SQLite URLs, implicit public registration and silent
# migration failures.
ENVIRONMENT=development
ORGANIZATION="NEXA Enterprise Insurance"
PORT=8010
FRONTEND_PORT=5174
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:8010

# Database Configuration (PostgreSQL in production; SQLite auto-fallback in dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=frauddb
# Optional full connection string override:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/frauddb

# JWT & Authentication — generate a unique value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Commercial access controls
# Demo accounts and one-click role switching are hidden unless DEMO_MODE=true.
DEMO_MODE=false
ALLOW_PUBLIC_REGISTRATION=false
MFA_REQUIRED=false
PASSWORD_MIN_LENGTH=12
# Password reset uses a single-use, hashed token delivered by SMTP only when
# all of these are configured. Otherwise /auth/forgot-password returns an
# honest configuration error and never claims an email was sent.
PASSWORD_RESET_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PASSWORD_RESET_FROM_EMAIL=no-reply@nexa.local
PASSWORD_RESET_TOKEN_MINUTES=30
# Public URL of the frontend; the reset email appends /reset-password?token=…
FRONTEND_RESET_URL=http://localhost:5174

# Multi-tenant isolation. With the flag off the deployment is single-tenant
# (legacy behaviour). Enable it for multi-tenant use, then create each
# organisation and its administrator with scripts/bootstrap_tenant.py.
TENANT_ISOLATION_ENABLED=false
# Self-registration in tenant mode requires a pre-existing active organisation.
DEFAULT_ORGANISATION_ID=
# Security Centre reports backup status from these explicit records only.
BACKUP_VERIFICATION_CONFIGURED=false
BACKUP_LAST_VERIFIED_AT=
# Restrict browser origins; do not use "*" with credentialed requests.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MODEL_VERSION=v1.2-ensemble-hybrid
# Optional supervised classifier trained by ml/train_supervised.py.
# It is advisory only; false or a missing artefact restores rule-only scoring.
SUPERVISED_MODEL_ENABLED=true
# FRAUD_MODEL_PATH=/absolute/path/to/fraud_classifier.joblib

# OCR & Document Intelligence Configuration
TESSERACT_CMD=tesseract
DOCUMENTS_DIR=data/documents
MAX_DOCUMENT_SIZE_MB=20

# Fraud Risk Classification Thresholds (configurable at runtime via /forensics/risk-thresholds)
RISK_THRESHOLD_LOW_MAX=29
RISK_THRESHOLD_MEDIUM_MAX=59
RISK_THRESHOLD_HIGH_MAX=79
RISK_THRESHOLD_CRITICAL_MAX=100

# Future Cloud OCR Integration (Azure AI Document Intelligence)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Internal enterprise system integrations
# Policy/customer/claims adapters read the local system-of-record tables by
# default. Set POLICY_SYSTEM_URL (and optional POLICY_SYSTEM_TOKEN) to read
# from an external policy administration API. Missing records stay missing;
# no synthetic policies, customers or claim histories are generated.
POLICY_SYSTEM_URL=
POLICY_SYSTEM_TOKEN=
POLICY_MANAGEMENT_API_URL=
CUSTOMER_MANAGEMENT_API_URL=
CLAIMS_MANAGEMENT_API_URL=
# No payment gateway or national ID provider is configured. Adapters report
# NOT_CONFIGURED rather than claiming a verification succeeded.
PAYMENT_GATEWAY_API_URL=
NATIONAL_ID_REGISTRY_API_URL=

# NEXA AI Intelligence Assistant (role-aware conversational chatbot, enabled by default)
CHATBOT_ENABLED=true
# Optional external LLM integration (OpenAI-compatible chat completions API).
# Leave CHATBOT_LLM_API_KEY empty to run the chatbot deterministically from real records.
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_BASE_URL=https://api.openai.com/v1
CHATBOT_LLM_MODEL=gpt-4o-mini

# NEXA Departmental AI Knowledge Base (RAG, Phase 5)
# Structured departmental packages are seeded from docs/knowledge_packages.
CHATBOT_KB_ENABLED=true
CHATBOT_KB_TOP_K=5
CHATBOT_KB_THRESHOLD=0.15
CHATBOT_KB_SEED=true
# CHATBOT_KB_PACKAGES_DIR=docs/knowledge_packages
